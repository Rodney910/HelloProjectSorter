<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HelloProject</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Iconos -->
    <link rel="icon" type="image/x-icon" href="~/assets/icons/Hermandad.png" />
    <link rel="shortcut icon" href="~/assets/icons/Hermandad.ico" type="image/x-icon">

    <!-- Estilos del módulo cargado -->
    <link rel="stylesheet" href="~/HelloProject.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg main-navbar shadow-sm">
            <div class="container-fluid">
                <!-- Logo y título -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/assets/icons/Hermandad.png" alt="Logo" class="navbar-logo me-2" style="width: 40px; height: 40px; margin-right: 10px;" />
                    <span class="fw-semibold text-white" style="font-family: Orbitron,sans-serif;">Hello! Project Sorter & Rankings</span>
                </a>

                <!-- Burger menu -->
                <button class="navbar-toggler text-white border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Links de navegación -->
                <div class="collapse navbar-collapse justify-content-end" id="navbarMain">
                    <ul class="navbar-nav mb-2 mb-lg-0">
                        <li class="nav-item" id="Idols">
                            <a class="nav-link fw-semibold px-3" asp-controller="Idols" asp-action="Index">Idols Sorter</a>
                        </li>
                        <li class="nav-item" id="Songs">
                            <a class="nav-link fw-semibold px-3" asp-controller="Songs" asp-action="Index">Songs Sorter</a>
                        </li>
                        <li class="nav-item" id="Others">
                            <a class="nav-link fw-semibold px-3" asp-controller="Others" asp-action="Index">Ranking</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido principal -->
    <div class="container-fluid main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted text-center py-3">
        <div class="container" style="color:#fff">
            &copy; 2026 - Hello! Project
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
