                { id: 9, kanji: "佐藤绚音", romaji: "Sato Ayane", song: "Aenai Nagai Nichiyoubi", artist: "Fujimoto Miki", img: "/assets/Kss/sato_ayane.png" },
                { id: 10, kanji: "田村椰々", romaji: "Tamura Nana", song: "BaBaBa Burning Love!", artist: "ANGERME", img: "/assets/Kss/tamura_nana.png" },
                { id: 11, kanji: "岸田桃果", romaji: "Kishida Momoka", song: "Kisoku Tadashiku Utsukushiku", artist: "ANGERME", img: "/assets/Kss/kishida_momoka.png" },
                { id: 12, kanji: "长井莉依な", romaji: "Nagai Riina", song: "Dakishimete Dakishimete", artist: "Berryz Kobo", img: "/assets/Kss/nagai_riina.png" },
                { id: 13, kanji: "染谷彩良", romaji: "Someya Sara", song: "Wagamama Ki no Mama Ai no Joke", artist: "Morning Musume", img: "/assets/Kss/someya_sara.png" },
                { id: 14, kanji: "吉田光里", romaji: "Yoshida Hikari", song: "Only you", artist: "Morning Musume", img: "/assets/Kss/yoshida_hikari.png" },
                { id: 15, kanji: "鈴木もあ", romaji: "Suzuki Moa", song: "Love take it all", artist: "°C-ute", img: "/assets/Kss/suzuki_moa.png" },
                { id: 16, kanji: "青木優奈", romaji: "Aoki Yuna", song: "Gashin Shoutan", artist: "ANGERME", img: "/assets/Kss/aoki_yuna.png" },
                { id: 17, kanji: "佐伯詩春", romaji: "Saeki Shiharu", song: "Ooki na Ai de Motenashite", artist: "°C-ute", img: "/assets/Kss/saeki_shiharu.png" },
                { id: 18, kanji: "根本花凛", romaji: "Nemoto Karin", song: "BLOODY BULLET", artist: "Juice=Juice", img: "/assets/Kss/nemoto_karin.png" },
