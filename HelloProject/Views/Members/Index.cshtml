            // --- SISTEMA DE EXPORTACIÓN (Títulos solo al inicio) ---

            function createScoreContent(idol, rating, isDetailed) {
                const cantoVal = formatScore(rating.canto);
                const baileVal = formatScore(rating.baile);
                const vestVal = formatScore(rating.vestuario);

                if (!isDetailed) {
                    return `
                    <div class="col-section">
                        <div class="content-area">
                            <div class="score-container">
                                        <div class="icon-wrapper icon-canto">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
                                        </div>
                                        <span class="score-value-simple score-value-large" style="color: var(--accent-primary)">${cantoVal}</span>
                                    </div>
                        </div>
                    </div>
                    <div class="col-section">
                        <div class="content-area">
                            <div class="score-container">
                                        <div class="icon-wrapper icon-baile">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                                        </div>
                                        <span class="score-value-simple score-value-large" style="color: var(--accent-secondary)">${baileVal}</span>
                                    </div>
                        </div>
                    </div>
                    <div class="col-section">
                        <div class="content-area">
                            <div class="score-container">
                                        <div class="icon-wrapper icon-vestuario">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"></path></svg>
                                        </div>
                                        <span class="score-value-simple score-value-large" style="color: var(--accent-amber)">${vestVal}</span>
                                    </div>
                        </div>
                    </div>
                `;
                } else {
                    const observations = [rating.obsCanto || "Sin observaciones", rating.obsBaile || "Sin observaciones", rating.obsVestuario || "Sin observaciones"];

                    return `
                    <div class="col-section">
                        <div class="content-area">
                           <div class="score-box">
                                        <div class="icon-wrapper icon-canto">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
                                        </div>
                                        <div class="score-details">
                                            <span class="score-label-mini">Canto</span>
                                            <span class="score-value" style="color: var(--accent-primary)">${cantoVal}</span>
                                        </div>
                                    </div>
                                    <div class="score-box">
                                        <div class="icon-wrapper icon-baile">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                                        </div>
                                        <div class="score-details">
                                            <span class="score-label-mini">Baile</span>
                                            <span class="score-value" style="color: var(--accent-secondary)">${baileVal}</span>
                                        </div>
                                    </div>
                                    <div class="score-box">
                                        <div class="icon-wrapper icon-vestuario">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"></path></svg>
                                        </div>
                                        <div class="score-details">
                                            <span class="score-label-mini">Vestuario</span>
                                            <span class="score-value" style="color: var(--accent-amber)">${vestVal}</span>
                                        </div>
                                    </div>
                        </div>
                    </div>
                    <div class="col-section">
                        <div class="content-area">
                            ${observations
                                .map(
                                    (obs) => `
                                <div class="obs-box">
                                    <p class="obs-text">${obs}</p>
                                </div>
                            `,
                                )
                                .join("")}
                        </div>
                    </div>
                `;
                }
            }

            function renderExportView(data) {
                const root = document.getElementById("export-root");
                root.className = `theme-${state.theme}`;
                const isDetailed = state.showObs.canto || state.showObs.baile || state.showObs.vestuario;
                const modeClass = isDetailed ? "detailed-mode" : "simple-mode";

                // Definir encabezado de columnas (una sola vez)
                let headerHTML = "";
                if (!isDetailed) {
                    headerHTML = `
                    <div class="premium-header-row simple-mode">
                        <div class="header-cell"><span class="section-label">Perfil</span></div>
                        <div class="header-cell"><span class="section-label">Canto</span></div>
                        <div class="header-cell"><span class="section-label" style="color: var(--accent-secondary);">Baile</span></div>
                        <div class="header-cell"><span class="section-label" style="color: var(--accent-amber);">Vestuario</span></div>
                        <div class="header-cell"><span class="section-label">Promedio</span></div>
                    </div>
                `;
                } else {
                    headerHTML = `
                    <div class="premium-header-row detailed-mode">
                        <div class="header-cell"><span class="section-label">Perfil</span></div>
                        <div class="header-cell"><span class="section-label">Calificaciones</span></div>
                        <div class="header-cell"><span class="section-label" style="color: var(--accent-purple);">Observaciones</span></div>
                        <div class="header-cell"><span class="section-label">Promedio</span></div>
                    </div>
                `;
                }

                let html = `
                        <div class="text-center mb-10">
                            <h2 style="font-family:'Orbitron', sans-serif; color:var(--accent-primary); font-size: 38px; letter-spacing: 4px;">SHINDAN TEST 2026</h2>
                        </div>
                        ${headerHTML}
                        <div id="cards-container">
                    `;

                data.forEach((idol) => {
                    const rating = state.ratings[idol.id];
                    const promedio = calcAvg(idol.id);
                    const avgNum = promedio;

                    html += `
                    <div class="premium-card ${modeClass}">
                        <!-- Columna Perfil (Datos sin header interno) -->
                        <div class="col-section">
                            <div class="content-area">
                                <div class="profile-container">
                                    <div class="mb-2">
                                        <span class="id-badge">#${idol.id}</span>
                                        <span class="idol-name">${idol.romaji}</span>
                                    </div>
                                    <div class="kanji-name">(${idol.kanji})</div>
                                    <img src="${idol.img}" alt="${idol.romaji}" class="idol-photo" onerror="this.src='https://placehold.co/100x100?text=HP'">
                                    <div>
                                        <h3 class="song-title">"${idol.song}"</h3>
                                        <p class="original-artist">${idol.artist}</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Secciones de Puntuación/Observaciones -->
                        ${createScoreContent(idol, rating, isDetailed)}

                        <!-- Columna Promedio -->
                        <div class="col-section">
                            <div class="content-area">
                                <div class="avg-display">
                                    <span class="avg-number">${promedio}</span>
                                    <div class="star-icon">${ICONS.star}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                });

                html += `
                        </div>
                        <div class="mt-10 pt-10 text-center" style="border-top: 2px solid var(--accent-primary); font-family: 'Orbitron', sans-serif; color: var(--accent-primary)">
                            🌸 HELLO PRO KENSHUUSEI SHINDAN TEST 2026 🌸
                        </div>
                    `;

                root.innerHTML = html;
            }

            async function exportAsImage() {
                const btn = document.getElementById("exportImage");
                const originalText = btn.innerHTML;

                btn.innerHTML = `GENERANDO...`;
                btn.disabled = true;

                try {
                    await document.fonts.ready;

                    const parts = [
                        { data: IDOLS_DATA.slice(0, 11), name: "Part1" },
                        { data: IDOLS_DATA.slice(11), name: "Part2" },
                    ];

                    for (const part of parts) {
                        // 🔥 Renderiza solo ese grupo
                        renderExportView(part.data);

                        // pequeño delay para render completo
                        await new Promise((r) => setTimeout(r, 400));

                        const canvas = await html2canvas(document.getElementById("export-root"), {
                            scale: 2.5,
                            useCORS: true,
                            backgroundColor: getComputedStyle(document.body).getPropertyValue("--bg-color").trim(),
                        });

                        const link = document.createElement("a");
                        link.download = `Shindan_${part.name}_${Date.now()}.png`;
                        link.href = canvas.toDataURL("image/png");
                        link.click();

                        // delay entre descargas (evita bloqueo del navegador)
                        await new Promise((r) => setTimeout(r, 300));
                    }
                } catch (err) {
                    console.error("Export Error:", err);
                } finally {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            }

            // --- GLOBAL HANDLERS ---
            window.updateVal = (id, field, val) => {
                state.ratings[id][field] = val;
                if (!field.startsWith("obs")) {
                    const avgEl = document.querySelector(`.avg-display-${id}`);
                    const avg = calcAvg(id);
                    avgEl.innerText = avg;
                    avgEl.style.color = avg !== "N/A" ? "var(--color-extra)" : "var(--text-dim)";
                }
            };

            // --- EVENTS ---
            document.getElementById("themeToggle").onclick = () => {
                state.theme = state.theme === "dark" ? "light" : "dark";
                document.body.className = `theme-${state.theme} transition-all`;
                document.getElementById("themeIcon").innerHTML = state.theme === "dark" ? ICONS.sun : ICONS.moon;
            };

            document.getElementById("obsControls").onclick = (e) => {
                const btn = e.target.closest(".obs-btn");
                if (!btn) return;
                const type = btn.dataset.obs;
                state.showObs[type] = !state.showObs[type];

                document.querySelectorAll(".obs-btn").forEach((b) => {
                    const t = b.dataset.obs;
                    const active = state.showObs[t];
                    b.className = `obs-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-[11px] font-bold transition-all ${active ? "btn-active" : "btn-inactive"}`;
                    if (active && t === "baile") b.style.backgroundColor = "var(--color-baile)";
                    else if (active && t === "vestuario") b.style.backgroundColor = "var(--color-vestuario)";
                    else b.style.backgroundColor = "";
                    b.querySelector(".eye-icon").innerHTML = active ? ICONS.eye : ICONS.eyeOff;
                });
                renderTable();
            };

            document.getElementById("exportImage").onclick = exportAsImage;
            document.getElementById("resetTrigger").onclick = () => (document.getElementById("resetModal").style.display = "flex");
            document.getElementById("cancelReset").onclick = () => (document.getElementById("resetModal").style.display = "none");
            document.getElementById("confirmReset").onclick = () => {
                initRatings();
                renderTable();
                document.getElementById("resetModal").style.display = "none";
            };

            // --- DRAG SCROLL ---
            const container = document.getElementById("tableContainer");

            let isDown = false;
            let startX;
            let scrollLeft;

            container.addEventListener("mousedown", (e) => {
                // Evita interferir con inputs
                if (e.target.closest("select, textarea, input")) return;

                isDown = true;
                container.classList.add("cursor-grabbing");
                container.classList.add("no-select");
                startX = e.pageX - container.offsetLeft;
                scrollLeft = container.scrollLeft;
            });

            container.addEventListener("mouseleave", () => {
                isDown = false;
                container.classList.remove("cursor-grabbing");
                container.classList.remove("no-select");
            });

            container.addEventListener("mouseup", () => {
                isDown = false;
                container.classList.remove("cursor-grabbing");
                container.classList.remove("no-select");
            });

            container.addEventListener("mousemove", (e) => {
                if (!isDown) return;

                e.preventDefault();

                const x = e.pageX - container.offsetLeft;
                const walk = (x - startX) * 1.5;
                container.scrollLeft = scrollLeft - walk;
            });

            // --- INIT ---
            initRatings();
            document.querySelectorAll(".obs-btn").forEach((b) => {
                const t = b.dataset.obs;
                const active = state.showObs[t];
                b.querySelector(".eye-icon").innerHTML = active ? ICONS.eye : ICONS.eyeOff;
            });
            document.getElementById("themeIcon").innerHTML = state.theme === "dark" ? ICONS.sun : ICONS.moon;
            renderTable();
        </script>
    </body>
</html>